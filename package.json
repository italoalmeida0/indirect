{
  "name": "indirect",
  "version": "2.2.12",
  "description": "LLM API gateway with a personal dashboard and a Code agent workspace.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch server/index.ts",
    "dev:web": "bun ./dev-web.ts 5700",
    "start": "bun server/index.ts",
    "build": "bun run build:daemon:all && bun run build:web",
    "build:web": "NODE_ENV=production bun ./build.ts",
    "build:daemon": "bun ./scripts/build-indirect-daemon.ts",
    "build:daemon:all": "bun ./scripts/build-indirect-all.ts",
    "release": "bun ./scripts/release.ts",
    "update": "bun ./scripts/release.ts",
    "update:release": "bun ./scripts/release.ts",
    "test": "DATA_DIR=./data/test INDIRECT_SKIP_VOICE_MODEL_DOWNLOAD=1 bun test",
    "lint": "eslint . && bun ./scripts/check-unused-exports.ts",
    "typecheck": "tsc --noEmit",
    "bench": "bun ./test/bench.ts",
    "fake-upstream": "bun ./test/fake-upstream.ts",
    "seed": "NODE_ENV=development bun ./scripts/seed-usage.ts",
    "perf:sim": "bun ./scripts/perf-sim.ts",
    "perf:tuning": "bun ./scripts/perf-tuning.ts",
    "perf:router-bench": "bun ./scripts/perf-router-bench.ts",
    "clean": "bun -e \"import { rmSync } from 'fs'; rmSync('dist', {recursive: true, force: true}); rmSync('data', {recursive: true, force: true});\"",
    "fclean": "bun run clean && bun -e \"import { rmSync } from 'fs'; rmSync('node_modules', {recursive: true, force: true});\"",
    "toolchains:vendor": "bun ./scripts/vendor-toolchains.ts"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@floating-ui/dom": "^1.8.0",
    "@jridgewell/remapping": "^2.3.5",
    "@opendocsg/pdf2md": "^0.3.6",
    "@signaldb/core": "^1.8.1",
    "@signaldb/indexeddb": "^1.1.0",
    "@signaldb/solid": "^1.0.0",
    "@signaldb/sync": "^1.3.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "ag-grid-community": "31.1.1",
    "astring": "^1.9.0",
    "btdby4-wasm": "^1.2.0",
    "cannon-es": "^0.20.0",
    "chart.js": "^4.6.1",
    "d3": "^7.9.2",
    "gsap": "^3.15.1",
    "highlight.js": "^11.12.0",
    "katex": "0.19.1",
    "leaflet": "^1.9.4",
    "magic-bytes.js": "^1.13.1",
    "magic-string": "^1.4.5",
    "marked": "^18.2.1",
    "matter-js": "^0.20.0",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "solid-ag-grid": "^0.0.230",
    "solid-charts": "0.0.2",
    "sortablejs": "^1.15.7",
    "streaming-markdown": "0.2.15",
    "sucrase": "^3.35.1",
    "three": "^0.186.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.157",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/matter-js": "^0.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.14.1",
    "babel-preset-solid": "^1.9.19",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.17.1",
    "onnxruntime-web": "1.30.0",
    "parakeet.js": "1.4.4",
    "postcss": "^8.5.33",
    "solid-js": "^1.9.19",
    "tailwindcss": "^4.3.5",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "onnxruntime-web": "1.30.0"
  },
  "patchedDependencies": {
    "streaming-markdown@0.2.15": "patches/streaming-markdown@0.2.15.patch"
  }
}
