# ===== Server =====
PORT=3000
NODE_ENV=production
# Directory where sqlite + local files live (mount a volume here in Docker)
DATA_DIR=./data
# Comma-separated origins allowed for the dashboard API (the dashboard itself is
# served same-origin, so this is mostly for dev on :5700)
ALLOWED_ORIGINS=http://localhost:5700
# Forwarded headers are ignored unless the socket peer matches an explicitly
# trusted proxy CIDR. Configure every proxy hop, and ensure the edge overwrites
# client-supplied forwarding headers. Example for a local reverse proxy:
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Absolute base URL of the dashboard, used in invite/password-reset emails
PUBLIC_URL=http://localhost:3000

# ===== Abuse tuning (safe defaults shown) =====
# Limits are per running gateway process. Account ceilings apply across all
# of a user's keys and cannot be raised by the key owner.
LIMIT_IP_PER_MIN=30000
LIMIT_AUTH_PER_MIN=1000
LIMIT_RESET_PER_10MIN=1000
LIMIT_USER_RPM=600
LIMIT_USER_CONCURRENCY=32
LIMIT_GLOBAL_CONCURRENCY=256
SQLITE_BUSY_TIMEOUT_MS=25
DEFAULT_KEY_RPM=120
DEFAULT_KEY_CONCURRENCY=16
# Failed logins per source IP before a 15-min lockout. This is the anti
# password-spray bucket for the whole IP — keep it MUCH higher than the
# per-account threshold (10): IPs are shared (family/NAT/CGNAT/office), and a
# low value lets a few typos lock out everyone behind the same address.
LIMIT_LOGIN_IP_FAIL_MAX=250

# ===== Secrets =====
# REQUIRED in production (boot fails otherwise): 32+ random bytes, hex or base64.
# Signs JWTs and encrypts the upstream provider API key at rest.
# Generate with: openssl rand -hex 32
INDIRECT_SECRET=
# (GATEWAY_SECRET is also supported as a fallback for backwards compatibility)

# ===== First-admin bootstrap (only used when the users table is empty) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ===== Google Sign-In (optional; empty = disabled) =====
# OAuth 2.0 "Web application" client ID. Authorized JS origin = your PUBLIC_URL.
GOOGLE_CLIENT_ID=

# ===== SMTP (optional; empty = emails are printed to server log instead) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Indirect <no-reply@example.com>"
# "true" = implicit TLS (usually port 465). false = STARTTLS when offered.
SMTP_SECURE=false
