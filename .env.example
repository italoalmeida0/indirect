# ===== Server =====
PORT=3000
NODE_ENV=production
# Directory where sqlite + local files live (mount a volume here in Docker)
DATA_DIR=./data
# Comma-separated origins allowed for the dashboard API (the dashboard itself is
# served same-origin, so this is mostly for dev on :5700)
ALLOWED_ORIGINS=http://localhost:5700
# Forwarded headers are ignored unless the socket peer matches an explicitly
# trusted proxy CIDR. Configure every proxy hop, and ensure the edge overwrites
# client-supplied forwarding headers. Example for a local reverse proxy:
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Absolute base URL of the dashboard, used in invite/password-reset emails
PUBLIC_URL=http://localhost:3000

# ===== Abuse tuning (safe defaults shown) =====
# Limits are per running gateway process. Account ceilings apply across all
# of a user's keys and cannot be raised by the key owner.
#
# Shared per-IP bucket for every dashboard and proxy route. Office, VPN and
# CGNAT egress put hundreds of employees behind one address; each open
# dashboard tab also polls (billing every 30s, workspace status every 15s).
# 60000/min is ~1000 req/s from one address, far above any legitimate polling
# pattern and still a hard flood bound. /api/health and /api/ready are exempt,
# so liveness and readiness probes never consume this budget.
LIMIT_IP_PER_MIN=60000
# Credential endpoints (login, 2FA, Google) in their own bucket. Must stay far
# above an office morning: 500 simultaneous sign-ins plus retries. The real
# anti-brute-force guards are the per-account lockout (10 failures) and the
# per-IP spray bucket below (LIMIT_LOGIN_IP_FAIL_MAX).
LIMIT_AUTH_PER_MIN=6000
LIMIT_RESET_PER_10MIN=1000
# Account ceilings: enforced ACROSS every key of one account, so adding keys
# never buys more of the shared gateway. Per-key limits (DEFAULT_KEY_RPM /
# DEFAULT_KEY_CONCURRENCY) still apply on top.
LIMIT_USER_RPM=600
LIMIT_USER_CONCURRENCY=32
# Whole-gateway concurrency. 500 employees rarely run more than one turn at a
# time; 512 bounds upstream sockets without rejecting a company-wide burst.
LIMIT_GLOBAL_CONCURRENCY=512
# Bounded admission queue in front of the concurrency ceilings. A request that
# would exceed a ceiling waits up to the deadline (milliseconds) and is
# released FIFO when a slot frees; past it the client gets 429 + Retry-After.
# The queue is capped by length and by declared request bytes.
LIMIT_ADMISSION_WAIT_MS=400
LIMIT_ADMISSION_QUEUE_MAX=1024
LIMIT_ADMISSION_QUEUE_BYTES=67108864
SQLITE_BUSY_TIMEOUT_MS=25
# Analytics readers run off the gateway event loop; the defaults scale up to
# eight workers, allow 256 in-flight/queued jobs, and bound each to five seconds.
# ANALYTICS_READERS=8
# ANALYTICS_PENDING=256
# ANALYTICS_DEADLINE_MS=5000
# ANALYTICS_HOURLY_DAYS=90
# ANALYTICS_MINUTE_DAYS=3
DEFAULT_KEY_RPM=120
DEFAULT_KEY_CONCURRENCY=16
# Failed logins per source IP before a 15-min lockout. This is the anti
# password-spray bucket for the whole IP — keep it MUCH higher than the
# per-account threshold (10): IPs are shared (family/NAT/CGNAT/office), and a
# low value lets a few typos lock out everyone behind the same address.
LIMIT_LOGIN_IP_FAIL_MAX=250

# ===== Secrets =====
# REQUIRED in production (boot fails otherwise): 32+ random bytes, hex or base64.
# Signs JWTs and encrypts the upstream provider API key at rest.
# Generate with: openssl rand -hex 32
INDIRECT_SECRET=
# (GATEWAY_SECRET is also supported as a fallback for backwards compatibility)

# ===== First-admin bootstrap (only used when the users table is empty) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ===== Google Sign-In (optional; empty = disabled) =====
# OAuth 2.0 "Web application" client ID. Authorized JS origin = your PUBLIC_URL.
GOOGLE_CLIENT_ID=

# ===== SMTP (optional; empty = emails are printed to server log instead) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Indirect <no-reply@example.com>"
# "true" = implicit TLS (usually port 465). false = STARTTLS when offered.
SMTP_SECURE=false
